# Variáveis de runtime (Coolify). Nunca commitar valores reais.

# --- Servidor (nunca expostas ao navegador) ---
# URL do webhook n8n que recebe o lead.
# dev:  .../webhook-test/<id>  (só responde com o editor do n8n em escuta)
# prod: .../webhook/<id>       (workflow ativo)
LEAD_WEBHOOK_URL=
# Conversions API da Meta (F-DADOS). Sem token a CAPI é desativada.
META_CAPI_ACCESS_TOKEN=
# Só durante a validação no Test Events; remover depois.
META_CAPI_TEST_EVENT_CODE=

# --- Públicas, lidas em runtime pelo loader da raiz (vazio desativa o recurso) ---
META_PIXEL_ID=
GA4_MEASUREMENT_ID=
VSL_VIDEO_URL=
