{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/wisleyaguiar/Projetos/lp-myteamrenovation/.codex/hooks/guard.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && cd \"$CLAUDE_PROJECT_DIR\" && npx --no-install prettier --write --ignore-unknown --log-level silent \"$f\" || true"
          }
        ]
      }
    ]
  }
}
